<?xml version="1.0" encoding="UTF-8"?>
<!--
  Эталонный pom для UI e2e на Java + Playwright + JUnit 5 + БД + мок-сервер.
  Версии актуальны на октябрь 2026. В закрытом контуре проверьте, что они есть в Nexus.
  Java 17+ нужна для: Jdbi 3.50+, Allure 3.x, JUnit 6. На Java 11: Jdbi <= 3.49, allure-junit5 2.x.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ru.bank.admin</groupId>
  <artifactId>admin-e2e-tests</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <playwright.version>1.63.0</playwright.version>
    <junit.version>5.14.1</junit.version>
    <allure.version>3.0.0</allure.version>          <!-- Java 11: 2.35.x и artifactId allure-junit5 -->
    <aspectj.version>1.9.24</aspectj.version>
    <jdbi.version>3.55.0</jdbi.version>
    <hikari.version>7.1.0</hikari.version>
    <postgres.version>42.7.13</postgres.version>
    <awaitility.version>4.3.0</awaitility.version>
    <assertj.version>3.27.6</assertj.version>
    <gson.version>2.13.2</gson.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- UI -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Тест-раннер -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Отчёт -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-jupiter</artifactId>
      <version>${allure.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- БД: пул + тонкая обёртка над JDBC с именованными параметрами -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikari.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-core</artifactId>
      <version>${jdbi.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgres.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Oracle: com.oracle.database.jdbc:ojdbc17:23.26.3.0.0 -->

    <!-- Ожидание асинхронных изменений (БД, мок-журнал) -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <version>${awaitility.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JSON для клиента мок-сервера. Объявляем явно, не полагаемся на транзитивную из Playwright -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- @Step и @Attachment Allure работают только через AspectJ-агент -->
          <argLine>
            -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
          </argLine>
          <systemPropertyVariables>
            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
          </systemPropertyVariables>
          <!-- Перезапуск упавших: включать только вместе с учётом флаков (Flakes: N в отчёте) -->
          <!-- <rerunFailingTestsCount>1</rerunFailingTestsCount> -->
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
